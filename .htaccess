<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Optional HTTPS (disable if it causes a redirect loop behind Cloudflare/proxy)
# Uncomment the next 3 lines only if you need force-HTTPS and no loop occurs:
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Existing files and directories (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs: /login -> login.html (matches vercel.json routes)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]
</IfModule>

DirectoryIndex index.html
